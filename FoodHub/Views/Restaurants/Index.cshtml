@model List<FoodHub.Models.Restuarnt>
@{
    ViewData["Title"] = "Restaurants";
}
<h3>Restaurants Count : @Model.Count</h3>
<table>
    <thead>
        <tr>
            <th> ID </th>
            <th> Name </th>
            <th> Rating </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Restuarnt in Model)
        {
            <tr>
                <td>@Restuarnt.ID</td>
                <td>@Restuarnt.Name</td>
                <td>@Restuarnt.Rating</td>
            </tr>
        }
    </tbody>
</table>
